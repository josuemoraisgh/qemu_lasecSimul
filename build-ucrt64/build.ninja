ninja_required_version = 1.8.2

# Rules for module scanning.

# Rules for compiling.

rule c_COMPILER_FOR_BUILD
 command = "cc" "-m64" "-mcx16" $ARGS -MD -MQ $out -MF $DEPFILE -o $out "-c" $in
 deps = gcc
 depfile = $DEPFILE_UNQUOTED
 description = Compiling C object $out

rule c_COMPILER
 command = "cc" "-m64" "-mcx16" $ARGS -MD -MQ $out -MF $DEPFILE -o $out "-c" $in
 deps = gcc
 depfile = $DEPFILE_UNQUOTED
 description = Compiling C object $out

rule cpp_COMPILER
 command = "c++" "-m64" "-mcx16" $ARGS -MD -MQ $out -MF $DEPFILE -o $out "-c" $in
 deps = gcc
 depfile = $DEPFILE_UNQUOTED
 description = Compiling C++ object $out

# Rules for linking.

rule STATIC_LINKER
 command = "ar" $LINK_ARGS $out $in
 description = Linking static target $out

rule STATIC_LINKER_RSP
 command = "ar" $LINK_ARGS $out @$out.rsp
 rspfile = $out.rsp
 rspfile_content = $in
 description = Linking static target $out

rule c_LINKER_FOR_BUILD
 command = "cc" "-m64" "-mcx16" $ARGS -o $out $in $LINK_ARGS
 description = Linking target $out

rule c_LINKER
 command = "cc" "-m64" "-mcx16" $ARGS -o $out $in $LINK_ARGS
 description = Linking target $out

rule c_LINKER_RSP
 command = "cc" "-m64" "-mcx16" @$out.rsp
 rspfile = $out.rsp
 rspfile_content = $ARGS -o $out $in $LINK_ARGS
 description = Linking target $out

rule cpp_LINKER
 command = "c++" "-m64" "-mcx16" $ARGS -o $out $in $LINK_ARGS
 description = Linking target $out

rule SHSYM
 command = "C:/SourceCode/qemu_lasecSimul/build-ucrt64/pyvenv/bin/meson" "--internal" "symbolextractor" "C:/SourceCode/qemu_lasecSimul/build-ucrt64" $in $IMPLIB $out $CROSS
 description = Generating symbol file $out
 restat = 1

# Other rules

rule CUSTOM_COMMAND
 command = $COMMAND
 description = $DESC
 restat = 1

rule CUSTOM_COMMAND_DEP
 command = $COMMAND
 deps = gcc
 depfile = $DEPFILE_UNQUOTED
 description = $DESC
 restat = 1

rule REGENERATE_BUILD
